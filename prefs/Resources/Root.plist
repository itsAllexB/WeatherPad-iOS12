<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>title</key><string>Weather for iPad</string>
	<key>items</key>
	<array>
		<dict>
			<key>cell</key><string>PSGroupCell</string>
			<key>footerText</key><string>Fixes for the iPhone Weather app on this iPad. Layout changes apply the next time Weather opens.</string>
		</dict>
		<dict>
			<key>cell</key><string>PSSwitchCell</string>
			<key>default</key><true/>
			<key>defaults</key><string>com.itsallexb.weatherpad</string>
			<key>key</key><string>enabled</string>
			<key>label</key><string>Enabled</string>
			<key>PostNotification</key><string>com.itsallexb.weatherpad/prefschanged</string>
		</dict>
		<dict>
			<key>cell</key><string>PSGroupCell</string>
			<key>label</key><string>Today Widget</string>
			<key>footerText</key><string>Tapping the Weather widget in Today View opens the Weather app for that city instead of weather.com. Applies right away.</string>
		</dict>
		<dict>
			<key>cell</key><string>PSSwitchCell</string>
			<key>default</key><true/>
			<key>defaults</key><string>com.itsallexb.weatherpad</string>
			<key>key</key><string>widgetOpensApp</string>
			<key>label</key><string>Widget Opens Weather App</string>
			<key>PostNotification</key><string>com.itsallexb.weatherpad/prefschanged</string>
		</dict>
		<dict>
			<key>cell</key><string>PSGroupCell</string>
			<key>label</key><string>Weather App</string>
			<key>footerText</key><string>Weather uses a full-screen iPad layout that also works in Split View and Slide Over. Turn on to run it in its iPhone layout instead (like other iPhone apps, with the 2x button and no multitasking). Needs a respring, then reopen Weather.</string>
		</dict>
		<dict>
			<key>cell</key><string>PSSwitchCell</string>
			<key>default</key><false/>
			<key>defaults</key><string>com.itsallexb.weatherpad</string>
			<key>key</key><string>iPhoneLayout</string>
			<key>label</key><string>Use iPhone Layout</string>
			<key>PostNotification</key><string>com.itsallexb.weatherpad/prefschanged</string>
		</dict>
		<dict>
			<key>cell</key><string>PSGroupCell</string>
			<key>label</key><string>Backgrounds</string>
			<key>footerText</key><string>Shows the animated weather backgrounds (clouds, rain, snow, lightning...) scaled to fill the iPad screen. Needs the WeatherUI resources from the iPhone firmware in /System/Library/PrivateFrameworks/WeatherUI.framework; without them, or when off, Weather shows a plain gradient. Applies the next time Weather opens.</string>
		</dict>
		<dict>
			<key>cell</key><string>PSSwitchCell</string>
			<key>default</key><true/>
			<key>defaults</key><string>com.itsallexb.weatherpad</string>
			<key>key</key><string>animatedBackgrounds</string>
			<key>label</key><string>Animated Backgrounds</string>
			<key>PostNotification</key><string>com.itsallexb.weatherpad/prefschanged</string>
		</dict>
		<dict>
			<key>cell</key><string>PSButtonCell</string>
			<key>label</key><string>Respring</string>
			<key>action</key><string>respring</string>
		</dict>
	</array>
</dict>
</plist>
